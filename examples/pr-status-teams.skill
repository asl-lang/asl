          type: "string"
        description: "Lista de boards a processar ('CORE', 'APP', ou ambos)"
      cards:
        type: "array"
        description: "Lista opcional de cards/PRs pré-carregados para execução determinística hermética"
        items:
          type: "object"
  output_schema:
    type: "object"
    additionalProperties: false
