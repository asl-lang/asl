interface:
  protocol: "mcp-tool-v1"
  entrypoint: "validate_and_format"
  input_schema:
    type: "object"
    additionalProperties: false
    required: ["intent", "diff_stat"]
    properties:
      intent:
        type: "string"
        description: "Intenção do commit fornecida pelo desenvolvedor"
      diff_stat:
        type: "string"
        description: "Estatística resumida do git diff"
  output_schema:
    type: "object"
    additionalProperties: false
    required: ["is_valid", "commit_type", "formatted_message", "diagnostics"]
    properties:
      is_valid:
        type: "boolean"
      commit_type:
        type: "string"
      formatted_message:
        type: "string"
      diagnostics:
        type: "array"
        items:
          type: "string"

capabilities:
  fs:
    confined_read_roots: []
    allow_write: []
  net:
    allow_domains: []
  wasi_components: []

limits:
  max_fuel_opcodes: 500000
  max_heap_kib: 8192
  wall_clock_timeout_ms: 1000
